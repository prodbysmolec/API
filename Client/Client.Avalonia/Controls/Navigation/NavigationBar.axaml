<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.Core.ViewModels.Navigation"
             xmlns:local="using:Client.Avalonia.Controls.Navigation"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="600"
             x:Class="Client.Avalonia.Controls.Navigation.NavigationBar"
             Name="SideBar">
 
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid HorizontalAlignment="Left" Width="240">
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#005381" />
                    <GradientStop Offset="0.5" Color="#1C7CB8" />
                    <GradientStop Offset="1.0" Color="#739bb9" />
                </LinearGradientBrush>
            </Border.Background>
            
            <!-- Decorative patterns/circles for visual interest -->
            <Canvas>
                <Ellipse Canvas.Left="-100" Canvas.Top="30" Width="200" Height="200" 
                         Fill="#15FFFFFF"/>
                <Ellipse Canvas.Right="-70" Canvas.Bottom="-70" Width="180" Height="180" 
                         Fill="#15FFFFFF"/>
                <Ellipse Canvas.Left="50" Canvas.Bottom="100" Width="40" Height="40" 
                         Fill="#15FFFFFF"/>
                <Ellipse Canvas.Right="70" Canvas.Top="80" Width="25" Height="25" 
                         Fill="#15FFFFFF"/>
            </Canvas>
        </Border>

        <!-- Sidebar Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Row="0" Margin="20,30,20,30">
                <Image Source="{Binding LogoSource, ElementName=SideBar}" Height="60" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Title, ElementName=SideBar}" Foreground="White" FontSize="18" 
                           FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Navigation Menu -->
            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavigationItems, ElementName=SideBar}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NavigationItemViewModel">
                            <local:NavigationButton Title="{Binding Title}"
                                                    IconData="{Binding IconData}"
                                                    IsActive="{Binding IsActive}"
                                                    NavigateCommand="{Binding NavigateCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- User Profile Section -->
            <local:UserProfileControl Grid.Row="2"
                                     DisplayName="{Binding UserProfile.DisplayName, ElementName=SideBar}"
                                     Email="{Binding UserProfile.Email, ElementName=SideBar}"
                                     Initials="{Binding UserProfile.Initials, ElementName=SideBar}"
                                     SettingsCommand="{Binding UserProfile.OpenSettingsCommand, ElementName=SideBar}"/>
        </Grid>
    </Grid>
    
</UserControl>