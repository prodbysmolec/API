<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="60"
             x:Class="Client.Avalonia.Controls.Navigation.UserProfileControl"
             Name="UserProfile">
    
    <Border Margin="15" Padding="10" Background="#20FFFFFF" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- User Avatar -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#40FFFFFF">
                <TextBlock Text="{Binding Initials, ElementName=UserProfile}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Foreground="White" FontWeight="Medium"/>
            </Border>
            
            <!-- User Name -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName, ElementName=UserProfile}" 
                          Foreground="White" FontWeight="Medium" FontSize="14"/>
                <TextBlock Text="{Binding Email, ElementName=UserProfile}" 
                          Foreground="White" Opacity="0.7" FontSize="12"/>
            </StackPanel>
            
            <!-- Settings Button -->
            <Button Grid.Column="2" Classes="text" Padding="8" 
                   Background="Transparent" Foreground="White"
                   Command="{Binding SettingsCommand, ElementName=UserProfile}">
                <PathIcon Data="M12 15.5C14 15.5 15.5 14 15.5 12C15.5 10 14 8.5 12 8.5C10 8.5 8.5 10 8.5 12C8.5 14 10 15.5 12 15.5ZM12 9.5C13.4 9.5 14.5 10.6 14.5 12C14.5 13.4 13.4 14.5 12 14.5C10.6 14.5 9.5 13.4 9.5 12C9.5 10.6 10.6 9.5 12 9.5ZM19.4 13C19.7 12.7 20 12.4 20.3 12C20 11.6 19.8 11.3 19.5 11L19.4 10.9C19.4 10.8 19.3 10.7 19.3 10.6C19.3 10.2 19.4 9.8 19.5 9.4C20 9.3 20.5 9.1 21 8.9L21.1 8.8C21.1 8.3 21 7.8 20.9 7.3C20.3 7.1 19.7 7 19.1 7C18.8 6.8 18.6 6.4 18.5 6C18.5 5.5 18.6 5 18.7 4.5L18.8 4.4C18.5 4 18.1 3.6 17.6 3.3C17.1 3.7 16.7 4 16.1 4.2L16 4.3C15.6 4.3 15.2 4.2 14.8 4.1C14.6 3.6 14.4 3.1 14.1 2.6L14 2.5C13.5 2.5 13 2.6 12.5 2.7C12.3 3.3 12.1 3.9 11.9 4.5L11.8 4.6C11.4 4.6 11.1 4.5 10.8 4.4C10.5 3.9 10.1 3.6 9.7 3.2L9.6 3.1C9.2 3.4 8.8 3.8 8.5 4.2C8.8 4.7 9.1 5.3 9.2 5.9L9.1 6.1C9 6.3 8.8 6.5 8.5 6.7C7.9 6.9 7.3 7.1 6.7 7.3L6.6 7.4C6.6 7.9 6.7 8.4 6.8 8.9C7.4 9.1 8 9.3 8.6 9.5L8.7 9.6C8.7 10 8.6 10.3 8.5 10.7C8 11 7.7 11.4 7.3 11.8L7.2 11.9C7.5 12.3 7.9 12.7 8.3 13C8.8 12.7 9.4 12.4 10 12.3H10.2C10.5 12.5 10.7 12.8 10.8 13.1C10.7 13.7 10.4 14.3 10.1 14.9V15C10.6 15.4 11.1 15.6 11.7 15.8C12 15.2 12.3 14.6 12.7 14.1L12.9 14C13.3 14 13.7 14.1 14.1 14.2C14.4 14.7 14.7 15.1 15.1 15.5L15.2 15.6C15.7 15.3 16.1 14.9 16.4 14.5C16.1 14 15.8 13.4 15.7 12.8V12.6C16.1 12.2 16.7 12 17.3 12C17.7 12 18.2 12.2 18.6 12.3L18.7 12.4L19.4 13Z" 
                         Width="20" Height="20"/>
            </Button>
        </Grid>
    </Border>
</UserControl>