<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.Core.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Client.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Bilder/Logo.png"
        Title="Merchandise System">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Button Styles -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#f29734"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#f7a34d"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#005381"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#00679e"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#005381"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.text:pointerover">
            <Setter Property="Foreground" Value="#f29734"/>
        </Style>
        <!-- Navigation Button Style -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>
        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#f29734"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Sidebar (Left Navigation) -->
        <Grid Name="SidebarGrid" HorizontalAlignment="Left" Width="240">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#005381" />
                        <GradientStop Offset="0.5" Color="#1C7CB8" />
                        <GradientStop Offset="1.0" Color="#739bb9" />
                    </LinearGradientBrush>
                </Border.Background>
                
                <!-- Decorative patterns/circles for visual interest -->
                <Canvas>
                    <Ellipse Canvas.Left="-100" Canvas.Top="30" Width="200" Height="200" 
                             Fill="#15FFFFFF"/>
                    <Ellipse Canvas.Right="-70" Canvas.Bottom="-70" Width="180" Height="180" 
                             Fill="#15FFFFFF"/>
                    <Ellipse Canvas.Left="50" Canvas.Bottom="100" Width="40" Height="40" 
                             Fill="#15FFFFFF"/>
                    <Ellipse Canvas.Right="70" Canvas.Top="80" Width="25" Height="25" 
                             Fill="#15FFFFFF"/>
                </Canvas>
            </Border>

            <!-- Sidebar Content -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <Image Source="/Assets/Bilder/Logo.png" Height="60" HorizontalAlignment="Left"/>
                    <TextBlock Text="Merchandise System" Foreground="White" FontSize="18" 
                               FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Classes="nav active">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M2 10.5C2 9.4 2.4 8.5 3.3 7.7C4.1 6.9 5.2 6.5 6.3 6.5H17.6C18.7 6.5 19.7 6.9 20.6 7.7C21.4 8.5 21.9 9.4 21.9 10.5V17.9C21.9 19.1 21.4 20 20.6 20.8C19.8 21.6 18.8 22 17.7 22H6.3C5.1 22 4.2 21.6 3.3 20.8C2.5 20 2 19 2 17.9V10.5ZM17.6 8.8H6.3C5.7 8.8 5.2 9.1 4.8 9.4C4.3 9.8 4.1 10.2 4.1 10.8V17.9C4.1 18.5 4.4 19 4.7 19.4C5.1 19.9 5.5 20.1 6.1 20.1H17.6C18.2 20.1 18.7 19.8 19.1 19.5C19.6 19.1 19.8 18.6 19.8 18.1V10.8C19.8 10.2 19.5 9.7 19.2 9.3C18.8 9 18.3 8.8 17.7 8.8H17.6Z M2 3.9C2 3.4 2.2 2.9 2.5 2.5C2.9 2.2 3.4 2 3.9 2H20C20.5 2 21 2.2 21.4 2.5C21.8 2.9 22 3.4 22 3.9C22 4.4 21.8 4.9 21.4 5.2C21 5.6 20.5 5.8 20 5.8H3.9C3.4 5.8 2.9 5.6 2.5 5.2C2.2 4.9 2 4.4 2 3.9Z" Width="22" Height="22" Foreground="White"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="nav">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M20 2H4C3 2 2 2.9 2 4V7.01C2 7.73 2.43 8.35 3 8.7V20C3 21.1 4.1 22 5 22H19C19.9 22 21 21.1 21 20V8.7C21.57 8.35 22 7.73 22 7.01V4C22 2.9 21 2 20 2ZM19 20H5V9H19V20ZM20 7H4V4H20V7Z M13 12H16V14H13V12Z M9 12H12V14H9V12Z M13 15H16V17H13V15Z M9 15H12V17H9V15Z" Width="22" Height="22" Foreground="White"/>
                                <TextBlock Text="Produkte" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="nav">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 6C13.1 6 14 6.9 14 8C14 9.1 13.1 10 12 10C10.9 10 10 9.1 10 8C10 6.9 10.9 6 12 6ZM12 13C9.33 13 4 14.34 4 17V20H20V17C20 14.34 14.67 13 12 13ZM12 15C14.67 15 18 16.25 18 17V18H6V17C6 16.25 9.33 15 12 15Z" Width="22" Height="22" Foreground="White"/>
                                <TextBlock Text="Kunden" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="nav">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM19 19H5V5H19V19ZM7 10H9V17H7V10ZM11 7H13V17H11V7ZM15 13H17V17H15V13Z" Width="22" Height="22" Foreground="White"/>
                                <TextBlock Text="Berichte" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="nav">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM19 11C19 15.52 16.02 19.69 12 20.93C7.98 19.69 5 15.52 5 11V6.3L12 3.19L19 6.3V11ZM7.41 11.59L6 13L10 17L18 9L16.59 7.58L10 14.17L7.41 11.59Z" Width="22" Height="22" Foreground="White"/>
                                <TextBlock Text="Einstellungen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- User Profile Section -->
                <Border Grid.Row="2" Margin="15" Padding="10" Background="#20FFFFFF" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- User Avatar -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#40FFFFFF">
                            <TextBlock Text="DS" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Foreground="White" FontWeight="Medium"/>
                        </Border>
                        
                        <!-- User Name -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock  Foreground="White" 
                                       FontWeight="Medium" FontSize="14"/>
                            <TextBlock  Foreground="White" 
                                       Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                        
                        <!-- Settings Button -->
                        <Button Grid.Column="2" Classes="text" Padding="8" 
                                Background="Transparent" Foreground="White">
                            <PathIcon Data="M12 15.5C14 15.5 15.5 14 15.5 12C15.5 10 14 8.5 12 8.5C10 8.5 8.5 10 8.5 12C8.5 14 10 15.5 12 15.5ZM12 9.5C13.4 9.5 14.5 10.6 14.5 12C14.5 13.4 13.4 14.5 12 14.5C10.6 14.5 9.5 13.4 9.5 12C9.5 10.6 10.6 9.5 12 9.5ZM19.4 13C19.7 12.7 20 12.4 20.3 12C20 11.6 19.8 11.3 19.5 11L19.4 10.9C19.4 10.8 19.3 10.7 19.3 10.6C19.3 10.2 19.4 9.8 19.5 9.4C20 9.3 20.5 9.1 21 8.9L21.1 8.8C21.1 8.3 21 7.8 20.9 7.3C20.3 7.1 19.7 7 19.1 7C18.8 6.8 18.6 6.4 18.5 6C18.5 5.5 18.6 5 18.7 4.5L18.8 4.4C18.5 4 18.1 3.6 17.6 3.3C17.1 3.7 16.7 4 16.1 4.2L16 4.3C15.6 4.3 15.2 4.2 14.8 4.1C14.6 3.6 14.4 3.1 14.1 2.6L14 2.5C13.5 2.5 13 2.6 12.5 2.7C12.3 3.3 12.1 3.9 11.9 4.5L11.8 4.6C11.4 4.6 11.1 4.5 10.8 4.4C10.5 3.9 10.1 3.6 9.7 3.2L9.6 3.1C9.2 3.4 8.8 3.8 8.5 4.2C8.8 4.7 9.1 5.3 9.2 5.9L9.1 6.1C9 6.3 8.8 6.5 8.5 6.7C7.9 6.9 7.3 7.1 6.7 7.3L6.6 7.4C6.6 7.9 6.7 8.4 6.8 8.9C7.4 9.1 8 9.3 8.6 9.5L8.7 9.6C8.7 10 8.6 10.3 8.5 10.7C8 11 7.7 11.4 7.3 11.8L7.2 11.9C7.5 12.3 7.9 12.7 8.3 13C8.8 12.7 9.4 12.4 10 12.3H10.2C10.5 12.5 10.7 12.8 10.8 13.1C10.7 13.7 10.4 14.3 10.1 14.9V15C10.6 15.4 11.1 15.6 11.7 15.8C12 15.2 12.3 14.6 12.7 14.1L12.9 14C13.3 14 13.7 14.1 14.1 14.2C14.4 14.7 14.7 15.1 15.1 15.5L15.2 15.6C15.7 15.3 16.1 14.9 16.4 14.5C16.1 14 15.8 13.4 15.7 12.8V12.6C16.1 12.2 16.7 12 17.3 12C17.7 12 18.2 12.2 18.6 12.3L18.7 12.4L19.4 13ZM16.2 4.8C16.7 4.6 17.2 4.4 17.7 4C18.1 4.4 18.4 4.9 18.7 5.3C18.3 5.8 18.1 6.3 18 6.9C18 7.6 18.3 8.3 18.8 8.7C19.4 8.9 19.9 9.1 20.5 9.3C20.5 9.8 20.4 10.4 20.3 10.9C19.7 11.2 19.2 11.5 18.8 12C18.3 12.7 18.2 13.5 18.5 14.2C18.3 14.7 18.1 15.2 17.7 15.7C17.2 15.3 16.6 15.1 16 15C15.3 15 14.6 15.3 14.2 15.8C13.9 16.3 13.6 16.8 13.3 17.3C12.8 17.3 12.3 17.2 11.7 17.1C11.4 16.5 11.1 16 10.6 15.6C10 15.1 9.1 15 8.4 15.3C8 15.8 7.5 16.1 7 16.3C6.6 15.9 6.3 15.4 6 14.9C6.4 14.4 6.6 13.9 6.7 13.3C6.7 12.6 6.4 11.9 5.9 11.5C5.3 11.3 4.8 11.1 4.2 10.9C4.2 10.4 4.3 9.8 4.4 9.3C5 9 5.5 8.7 5.9 8.2C6.4 7.5 6.5 6.7 6.2 6C6.4 5.5 6.6 5 7 4.5C7.5 4.9 8.1 5.1 8.7 5.2C9.4 5.2 10.1 4.9 10.5 4.4C10.8 3.9 11.1 3.4 11.4 2.9C11.9 2.9 12.4 3 13 3.1C13.3 3.7 13.6 4.2 14.1 4.6C14.7 5.1 15.5 5.2 16.2 4.9V4.8Z" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <Grid Margin="240,0,0,0">
            <!-- Header Area -->
            <Border Height="70" VerticalAlignment="Top" Background="White" 
                    BoxShadow="0 2 10 0 #10000000">
                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Page Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" 
                                   Foreground="#363636"/>
                        <TextBlock Text=" / Übersicht" FontSize="20" Foreground="#737373" 
                                   Opacity="0.7"/>
                    </StackPanel>
                    
                    <!-- Header Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                        <!-- Search Button -->
                        <Button Classes="text" Padding="8" Background="#F5F5F5" CornerRadius="8">
                            <PathIcon Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z" Width="20" Height="20"/>
                        </Button>
                        
                        <!-- Notifications Button -->
                        <Button Classes="text" Padding="8" Background="#F5F5F5" CornerRadius="8">
                            <Grid>
                                <PathIcon Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.37 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.64 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z" Width="20" Height="20"/>
                                <Ellipse Width="8" Height="8" Fill="#f29734" Stroke="White" StrokeThickness="1.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
                            </Grid>
                        </Button>
                        
                        <!-- Help Button -->
                        <Button Classes="text" Padding="8" Background="#F5F5F5" CornerRadius="8">
                            <PathIcon Data="M11 18H13V16H11V18ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM12 6C9.79 6 8 7.79 8 10H10C10 8.9 10.9 8 12 8C13.1 8 14 8.9 14 10C14 12 11 11.75 11 15H13C13 12.75 16 12.5 16 10C16 7.79 14.21 6 12 6Z" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Main Content Container -->
            <Border Margin="0,70,0,0" Background="#F5F5F5" CornerRadius="0">
                <Grid Margin="25">
                    <!-- Content will go here via ContentPresenter -->
                    <ContentControl>
                        <ContentControl.ContentTemplate>
                            <!-- Example placeholder for dashboard content -->
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Quick Stats -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Stat Card 1 -->
                                        <Border Grid.Column="0" Margin="0,0,10,0" Background="White" 
                                                CornerRadius="12" BoxShadow="0 2 10 0 #08000000" Padding="20">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Gesamtumsatz" Foreground="#737373" FontSize="14"/>
                                                    <TextBlock Text="€24,780" Foreground="#363636" FontSize="24" 
                                                               FontWeight="Bold" Margin="0,5"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <PathIcon Data="M7 14L12 9L17 14H7Z" Foreground="#4CAF50"/>
                                                        <TextBlock Text="+8.2%" Foreground="#4CAF50" Margin="5,0,0,0"/>
                                                        <TextBlock Text="von letztem Monat" Foreground="#737373" 
                                                                  FontSize="12" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Background="#f2973420" Width="50" Height="50" CornerRadius="12" 
                                                        HorizontalAlignment="Right">
                                                    <PathIcon Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2ZM13.41,18.09L13.38,20H10.5V18.09C8.86,17.84 7.53,16.94 7.08,15.18L9.2,14.73C9.4,15.59 10.17,16.36 12.08,16.36C14.18,16.36 14.45,15.5 14.45,14.91C14.45,14 14.14,13.45 11.73,13.01C9.3,12.58 7.37,11.59 7.37,9.14C7.37,7.91 8.09,6.25 10.36,5.81V4H13.23V5.81C14.91,6.14 15.91,7.2 16.18,8.45L14.1,8.91C13.86,7.95 13.14,7.41 12.08,7.41C10.3,7.41 10.23,8.45 10.23,8.87C10.23,9.76 10.7,10.11 12.91,10.5C15.09,10.89 17.32,11.8 17.32,14.82C17.32,16.19 16.38,17.82 13.41,18.09Z" 
                                                              Foreground="#f29734" Width="24" Height="24" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Stat Card 2 -->
                                        <Border Grid.Column="1" Margin="10,0" Background="White" 
                                                CornerRadius="12" BoxShadow="0 2 10 0 #08000000" Padding="20">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Bestellungen" Foreground="#737373" FontSize="14"/>
                                                    <TextBlock Text="384" Foreground="#363636" FontSize="24" 
                                                               FontWeight="Bold" Margin="0,5"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <PathIcon Data="M7 10L12 15L17 10H7Z" Foreground="#F44336"/>
                                                        <TextBlock Text="-2.4%" Foreground="#F44336" Margin="5,0,0,0"/>
                                                        <TextBlock Text="von letzter Woche" Foreground="#737373" 
                                                                  FontSize="12" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Background="#00538120" Width="50" Height="50" CornerRadius="12" 
                                                        HorizontalAlignment="Right">
                                                    <PathIcon Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM19 19H5V5H19V19ZM7 10H9V17H7V10ZM11 7H13V17H11V7ZM15 13H17V17H15V13Z" 
                                                              Foreground="#005381" Width="24" Height="24" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Stat Card 3 -->
                                        <Border Grid.Column="2" Margin="10,0" Background="White" 
                                                CornerRadius="12" BoxShadow="0 2 10 0 #08000000" Padding="20">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Kunden" Foreground="#737373" FontSize="14"/>
                                                    <TextBlock Text="1,204" Foreground="#363636" FontSize="24" 
                                                               FontWeight="Bold" Margin="0,5"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <PathIcon Data="M7 14L12 9L17 14H7Z" Foreground="#4CAF50"/>
                                                        <TextBlock Text="+12.7%" Foreground="#4CAF50" Margin="5,0,0,0"/>
                                                        <TextBlock Text="im letzten Quartal" Foreground="#737373" 
                                                                  FontSize="12" Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Background="#73518120" Width="50" Height="50" CornerRadius="12" 
                                                        HorizontalAlignment="Right">
                                                    <PathIcon Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 6C13.1 6 14 6.9 14 8C14 9.1 13.1 10 12 10C10.9 10 10 9.1 10 8C10 6.9 10.9 6 12 6ZM12 13C9.33 13 4 14.34 4 17V20H20V17C20 14.34 14.67 13 12 13ZM12 15C14.67 15 18 16.25 18 17V18H6V17C6 16.25 9.33 15 12 15Z" 
                                                              Foreground="#735181" Width="24" Height="24" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
