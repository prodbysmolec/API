<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Client.Core.ViewModels"
        xmlns:views="using:Client.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Client.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:common="using:Client.Avalonia.Controls.Common"
        xmlns:navigation="using:Client.Avalonia.Controls.Navigation"
        Icon="/Assets/Bilder/Logo.png"
        Title="Merchandise System">
        <TransitioningContentControl Content="{Binding CurrentMainView}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.5" />
                <!--
                         Alternative Transitionen:
        <PageSlide Duration="0:0:0.3" Orientation="Horizontal" />
        <CompositePageTransition>
            <CrossFade Duration="0:0:0.2" />
            <PageSlide Duration="0:0:0.3" Orientation="Horizontal" />
        </CompositePageTransition>
        -->
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
</Window>