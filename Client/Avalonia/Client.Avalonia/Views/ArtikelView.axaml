<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Client.Core.ViewModels"
             xmlns:converters="using:Client.Avalonia.Converters"

             x:DataType="vm:ArtikelViewModel"
             x:Class="Client.Avalonia.Views.ArtikelView">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    <converters:ArtikelStatusToColorConverter x:Key="ArtikelStatusToColorConverter"/>
    <converters:BestandVerfuegbarConverter x:Key="BestandVerfuegbarConverter"/>
    <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:UnterMindestbestandConverter x:Key="UnterMindestbestandConverter"/>

  </UserControl.Resources>
  
  <UserControl.Styles>
    <StyleInclude Source="../Styles/Styles.axaml"/>
  </UserControl.Styles>

  <Grid>
    <SplitView IsPaneOpen="True" 
               DisplayMode="Inline"
               OpenPaneLength="400"
               PaneBackground="White"
               CompactPaneLength="50">
      
      <!-- Linke Seitenleiste mit Artikelliste -->
      <SplitView.Pane>
        <Border Background="White" BoxShadow="0 0 10 0 #15000000">
          <Grid RowDefinitions="Auto,*">
            <!-- Suchleiste und Filter -->

        
        <!-- DataGrid für die Artikelliste -->
        <DataGrid Grid.Row="1" 
                  Margin="0" 
                  ItemsSource="{Binding ArtikelDtos}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="Black"
                  VerticalGridLinesBrush="Black"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedArtikel}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Visible"
                  BorderBrush="Gray">
          <DataGrid.Columns>
            <!-- Artikelname -->
            <DataGridTemplateColumn Width="auto" Header="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Id, StringFormat='#{0}'}" 
                                 Foreground="{DynamicResource TextLightBrush}" FontSize="12"/>
                      <TextBlock Text="{Binding Status}" 
                                 Foreground="{DynamicResource SecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            
            <!-- Gesamtmenge --> 
            <DataGridTemplateColumn Width="95" Header="Menge">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding Menge}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            
            <!-- Preis --> 
            <DataGridTemplateColumn Width="95" Header="Preis">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding Preis}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            
            <!-- Einzelpreis --> 
            <DataGridTemplateColumn Width="auto" Header="Einzelpreis">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding Menge}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            
            <!-- Image Grid Column -->
            <DataGridTemplateColumn Width="100" Header="Bild">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Width="50" Height="50" Background="#F5F5F5" CornerRadius="8" Margin="4"
                          BoxShadow="0 1 4 0 #10000000">
                    <Image Source="{Binding Bild, Converter={StaticResource ByteArrayToImageConverter}}" 
                           Stretch="Uniform" Margin="6"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            
            <!-- Artikelgruppe -->
            <DataGridTemplateColumn Width="100" Header="Artikelgruppe">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding ArtikelGruppe}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            
            <!-- Lieferant -->
            <DataGridTemplateColumn Width="100" Header="Lieferant">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,8">
                    <TextBlock Text="{Binding HauptLieferant}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>

          <DataGrid.Styles>
            <!-- Header Style -->
            <Style Selector="DataGridColumnHeader">
              <Setter Property="Background" Value="{DynamicResource PrimaryHoverColor}"/>
              <Setter Property="Foreground" Value="{DynamicResource BackgroundColor}"/>
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="AreSeparatorsVisible" Value="True"/>
              <Setter Property="Padding" Value="8 14"/>
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            
            <!-- Row Styles -->
            <Style Selector="DataGridRow">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Foreground" Value="{DynamicResource TextDarkColor}"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0 2"/>
              <Setter Property="BorderThickness" Value="0 0 0 1"/>
              <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
              <Setter Property="CornerRadius" Value="4"/>
            </Style>
            
            <Style Selector="DataGridCell:selected">
              <Setter Property="Background" Value="{DynamicResource TextLightColor}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextDarkColor}"/>
            </Style>

  
            <Style Selector="DataGridRow:pointerover">
              <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
              <Setter Property="Cursor" Value="Hand"/>
            </Style>
  
            <Style Selector="DataGridCell">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Padding" Value="4"/>
            </Style>
          </DataGrid.Styles>
        </DataGrid>
          </Grid>
        </Border>
      </SplitView.Pane>
      
      <!-- Rechter Bereich mit Detailansicht -->
      <Border Background="{DynamicResource BackgroundBrush}" Padding="20">
        <Grid RowDefinitions="Auto,*">
          <!-- Pfad und Aktionen -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Content="Artikel" Classes="text" Padding="0" VerticalAlignment="Center"/>
              <TextBlock Text="/" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SelectedArtikel.Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Classes="icon" Padding="8">
                <!-- ToDo: Icon ersetzen -->
                <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Width="16" Height="16"/>
              </Button>
            </StackPanel>
          </Grid>
          
          <!-- Detailansicht mit ScrollViewer -->
          <ScrollViewer Grid.Row="1">
            <Grid RowDefinitions="Auto,*">
              <!-- Header-Bereich mit responsivem Layout -->
              <Border Grid.Row="0" Classes="card" Margin="0,0,0,20">
                <Grid RowDefinitions="Auto,Auto,Auto">
                  <!-- Erste Zeile: Bild und Basisinformationen -->
                  <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                    <!-- Artikelbild -->
                    <Border Grid.Column="0" Width="120" Height="120" Background="#F5F5F5" CornerRadius="8" Margin="0,0,20,0">
                      <Panel>
                        <Image Stretch="Uniform" Margin="10"/>
                        <Button Classes="icon" Content="+" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                      </Panel>
                    </Border>
                    
                    <!-- Zentrale Artikelinformationen -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SelectedArtikel.Name}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                      <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,4">
                          <TextBlock Text="{Binding SelectedArtikel.Status}" Foreground="White" FontSize="12"/>
                        </Border>
                        <TextBlock Foreground="{DynamicResource TextLightBrush}" Margin="0,0,10,4">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="ID: {0}" FallbackValue="12">
                              <Binding Path="SelectedArtikel.Id"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedArtikel.ArtikelGruppe, StringFormat='Artikelgruppe: {0}'}" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                      </WrapPanel>
                      
                      <!-- Bestandsanzeige -->
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="Bestand:" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" Margin="10,0,10,0">
                          <Border Grid.Row="0" Height="8" Background="#E0E0E0" CornerRadius="4">
                            <Border HorizontalAlignment="Left" Width="60" Height="8" Background="{DynamicResource SecondaryBrush}" CornerRadius="4"/>
                          </Border>
                          
                          <!-- WrapPanel für responsive Anzeige -->
                          <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <!-- Min-Wert -->
                            <Border Margin="0,0,8,4" Padding="0">
                              
                              <TextBlock Text="Min: 10" FontSize="11" Foreground="{DynamicResource TextLightBrush}"/>
                            </Border>
      
                            <!-- Aktueller Wert -->
                            <Border Margin="0,0,8,4" Padding="0">
                              <TextBlock Text="Aktuell: 60" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
      
                            <!-- Max-Wert -->
                            <Border Margin="0,0,0,4" Padding="0">
                              <TextBlock Text="Max: 100" FontSize="11" Foreground="{DynamicResource TextLightBrush}"/>
                            </Border>
                          </WrapPanel>
                        </Grid>
                      </Grid>
                    </StackPanel>
                  </Grid>
                  
                  <!-- Zweite Zeile: Preis und Aktionen -->
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,16,0,0" MinWidth="0">
                    <!-- Preisanzeige -->
                    <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="16,12" HorizontalAlignment="Left" MinWidth="120" MaxWidth="180">
                      <StackPanel>
                        <TextBlock Text="Preis" FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock Text="29,99 €" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                      </StackPanel>
                    </Border>
                    
                    <!-- Aktionen -->
                    <ItemsControl Grid.Column="1" HorizontalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <Button Content="Wareneingang" Classes="secondary" Padding="12,8" Margin="0,0,0,8">
                        <Button.Flyout>
                          <Flyout Placement="Bottom">
                            <StackPanel Width="250">
                              <TextBlock Text="Wareneingang erfassen" FontWeight="Bold" Margin="0,0,0,8"/>
                              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Menge:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="1" Minimum="1" FormatString="0"/>
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Einzelpreis:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="29,99 €"/>
                              </Grid>
                              <Button Content="Bestätigen" Classes="primary" Margin="0,8,0,0"/>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <Button Content="Warenausgang" Classes="primary" Padding="12,8" Margin="0,0,0,8">
                        <Button.Flyout>
                          <Flyout Placement="Bottom">
                            <StackPanel Width="250">
                              <TextBlock Text="Warenausgang erfassen" FontWeight="Bold" Margin="0,0,0,8"/>
                              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Zweck:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                  <ComboBoxItem Content="Verkauf"/>
                                  <ComboBoxItem Content="Intern"/>
                                  <ComboBoxItem Content="Defekt"/>
                                </ComboBox>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Menge:" VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="1" Minimum="1" FormatString="0" Margin="0,8,0,0"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Preis:" VerticalAlignment="Center" Margin="0,8,8,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="29,99 €" Margin="0,8,0,0"/>
                              </Grid>
                              <Button Content="Bestätigen" Classes="primary" Margin="0,8,0,0"/>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </ItemsControl>
                  </Grid>
                  
                  <!-- Dritte Zeile: Statusleiste (optional) -->
                  <WrapPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal">
                    <!-- Aktualisierungsstatus -->
                    <Border Margin="0,0,16,8" Padding="0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" 
                                  Width="14" Height="14" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock Foreground="{DynamicResource TextLightBrush}" FontSize="12" Margin="0,0,10,4">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="Letzte Aktualisierung: {0}" FallbackValue="">
                              <Binding Path="SelectedArtikel.ZuletztBearbeitetAm"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Border>
  
                    <!-- Bearbeiter-Status -->
                    <Border Margin="0,0,0,8" Padding="0">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                  Width="14" Height="14" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock Foreground="{DynamicResource TextLightBrush}" FontSize="12" Margin="0,0,10,4">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="Bearbeitet von: {0}" FallbackValue="">
                              <Binding Path="SelectedArtikel.ZuletztBearbeitetVon"/>
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </SplitView>
  </Grid>
</UserControl>