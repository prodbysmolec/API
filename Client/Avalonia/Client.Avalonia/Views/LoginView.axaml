<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.Core.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="Client.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#f29734"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#f7a34d"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#005381"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#00679e"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#005381"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.text:pointerover">
            <Setter Property="Foreground" Value="#f29734"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#739bb9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="#739bb9"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="BorderBrush" Value="#f29734"/>
            <Setter Property="Foreground" Value="#005381"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#005381"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#4A4A4A"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Styles>

    <!-- Main Border with Rounded Corners -->
    <Border CornerRadius="12" Background="White" BoxShadow="0 4 25 0 #20000000">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*" />
                <ColumnDefinition Width="0.6*" />
            </Grid.ColumnDefinitions>

            <!-- Design/Branding Panel (Left Side) -->
            <Border Grid.Column="0" CornerRadius="12,0,0,12">
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0.0" Color="#005381" />
                                <GradientStop Offset="0.5" Color="#1C7CB8" />
                                <GradientStop Offset="1.0" Color="#739bb9" />
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <!-- Decorative patterns/circles -->
                        <Canvas>
                            <Ellipse Canvas.Left="-100" Canvas.Top="30" Width="200" Height="200" 
                                     Fill="#15FFFFFF"/>
                            <Ellipse Canvas.Right="-70" Canvas.Bottom="-70" Width="180" Height="180" 
                                     Fill="#15FFFFFF"/>
                            <Ellipse Canvas.Left="50" Canvas.Bottom="100" Width="40" Height="40" 
                                     Fill="#15FFFFFF"/>
                            <Ellipse Canvas.Right="70" Canvas.Top="80" Width="25" Height="25" 
                                     Fill="#15FFFFFF"/>
                        </Canvas>
                    </Border>

                    <!-- Logo and Welcome Text -->
                    <StackPanel VerticalAlignment="Center" Spacing="20" Margin="30,0">
                        <Image Source="/Assets/Bilder/Logo.png" Height="100" HorizontalAlignment="Center"/>
                        
                        <StackPanel Spacing="10" Margin="0,20,0,0">
                            <TextBlock Text="Willkommen zurück" 
                                       HorizontalAlignment="Center"
                                       Foreground="White" 
                                       FontSize="28" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Wir freuen uns, Sie wiederzusehen. Greifen Sie auf Ihr Konto zu, indem Sie sich mit Ihren persönlichen Daten anmelden." 
                                       HorizontalAlignment="Center"
                                       Foreground="White" 
                                       FontSize="14" 
                                       TextWrapping="Wrap"
                                       Opacity="0.9"
                                       TextAlignment="Center"
                                       Margin="0,0,0,15"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Authentication Panel (Right Side) -->
            <Grid Grid.Column="1" Margin="40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Authentication Title -->
                <TextBlock Grid.Row="0" Text="Merchandise System" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#363636"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,15"/>

                <!-- Authentication Form -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Margin="0,25,0,0">
                        <!-- Username Field -->
                        <TextBlock Text="Benutzername" 
                                  Foreground="#4A4A4A" 
                                  FontSize="14" 
                                  Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Username}" 
                                Watermark="Benutzernamen eingeben"/>

                        <!-- Password Field -->
                        <TextBlock Text="Passwort" 
                                  Foreground="#4A4A4A" 
                                  FontSize="14" 
                                  Margin="0,0,0,8"/>
                        <Grid>
                            <TextBox x:Name="PasswordTextBox" 
                                     Text="{Binding Password}"
                                     PasswordChar="•" 
                                     Watermark="Passwort eingeben"/>
                            <Button Content="👁️" 
                                   HorizontalAlignment="Right" 
                                   Width="45" 
                                   Height="45" 
                                   Background="Transparent" 
                                   BorderThickness="0" 
                                   x:Name="ShowPasswordButton"/>
                        </Grid>

                        <!-- Error Message Display -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                  Foreground="#D32F2F"
                                  FontSize="14"
                                  Margin="0,10,0,0"
                                  TextWrapping="Wrap"
                                  IsVisible="{Binding !!ErrorMessage}"/>

                        <!-- Remember Me and Forgot Password -->
                        <Grid Margin="0,15,0,25">
                            <CheckBox Content="Angemeldet bleiben" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center"/>
                            <Button Content="Passwort vergessen?" 
                                   Classes="text"
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center"
                                   x:Name="ForgotPasswordButton"/>
                        </Grid>

                        <!-- Login Button with Loading State -->
                        <Button 
                               Classes="primary"
                               Height="50" 
                               Margin="0,10,0,25" 
                               Command="{Binding LoginCommand}"
                               IsEnabled="{Binding !IsLoading}">
                            <Button.Content>
                                <Panel>
                                    <TextBlock Text="ANMELDEN" IsVisible="{Binding !IsLoading}"/>
                                    <ProgressBar IsIndeterminate="True" 
                                                IsVisible="{Binding IsLoading}" 
                                                HorizontalAlignment="Center"
                                                Width="20" Height="20" 
                                                Foreground="White"/>
                                </Panel>
                            </Button.Content>
                        </Button>

                        <!-- Register Link -->
                        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Run Text="Noch kein Konto?" Foreground="#4A4A4A"/>
                            <Run Text=" Registrieren" Foreground="#005381" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <TextBlock Grid.Row="2" 
                          Text="© 2025 Smolec Productions. Alle Rechte vorbehalten." 
                          Foreground="#9E9E9E" 
                          FontSize="12" 
                          HorizontalAlignment="Center" 
                          Margin="0,30,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>